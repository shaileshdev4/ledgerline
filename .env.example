# Copy to .env.local and fill in. Never commit .env.local.

# --- Text structuring (OCR text → JSON) ---
# Required for Puter OCR pipeline on the server. Groq free tier works for hackathons.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_TEXT_MODEL=llama-3.1-8b-instant

# --- Vision fallback (optional) ---
# Only used when Puter OCR + text structuring both fail on an image upload.
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Anthropic (higher-quality vision fallback)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Client OCR ---
# Receipt/P2P images are OCR'd in the browser via Puter.js (no key required).
# Future: move OCR to a backend worker; server ingest API already accepts ocrTexts.
